# Copy this file to ".env" in the same directory (project root) before running:
#   docker compose up
#   or local backend: uvicorn from apps/firescrapling/backend
#
# Docker Compose reads ".env" automatically for variable substitution and passes
# these values into the backend container (see docker-compose.yml).

# --- Backend (FastAPI / CORS) ---
# Comma-separated origins allowed by the API (browser + nginx proxy)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# API auth: require Authorization: Bearer <api_key> or X-API-Key for /v1/scrape|crawl|map
# Set to false for local dev only (no tenant isolation).
# API_REQUIRE_AUTH=true

# Allow http://localhost / private IPs for scrapes (local dev only).
# API_ALLOW_PRIVATE_URLS=false

# Per-key sliding window (requests per minute, in-process).
# RATE_LIMIT_PER_MINUTE=60

# Admin console (/v1/admin/*). Required to unlock the Admin UI. Leave unset to disable.
# ADMIN_SECRET=change-me-to-a-long-random-string

# Logging (uvicorn / app loggers)
# LOG_LEVEL=INFO

# --- BYOK (bring your own Scrape.do / Scrapfly key) ---
# BYOK_ENABLED=false
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIAL_ENCRYPTION_KEY=
# Or rotate with newest first: CREDENTIAL_ENCRYPTION_KEYS=new,old
# CREDENTIAL_ENCRYPTION_KEYS=
# When true, platform SCRAPE_API_KEY / SCRAPFLY_API_KEY remain a fallback after user BYOK.
# MANAGED_FETCH_ENABLED=true

# --- Fetch provider (Scrape.do / Scrapfly / local) ---
# auto = Scrape.do if SCRAPE_API_KEY set, else Scrapfly if SCRAPFLY_API_KEY, else local
# FETCH_PROVIDER=auto
# SCRAPE_API_KEY=
# SCRAPFLY_API_KEY=
# SCRAPFLY_PROXY_POOL=public_datacenter_pool
# Escalation may use residential as a last step (override name if needed):
# SCRAPFLY_RESIDENTIAL_POOL=public_residential_pool
# SCRAPFLY_COUNTRY=
# Budget-safe defaults — auto-escalate enables JS/ASP only when a cheap probe fails
# SCRAPFLY_DEFAULT_RENDER_JS=false
# SCRAPFLY_DEFAULT_ASP=false
# Cheap-first ladder (local → static → +JS → +ASP/super → residential). Set false to disable.
# FETCH_ESCALATE=true
# FETCH_PROFILE_TTL_SECONDS=86400
# Local HTML cache TTL (seconds) for successful scrapes
# SCRAPE_CACHE_TTL=3600

# --- Job queue (Redis + RQ workers) ---
# REDIS_URL=redis://redis:6379/0
# WORKER_CONCURRENCY=2
# QUEUE_ENABLED=true

# --- Database (default: sqlite under apps/firescrapling/backend/data/db) ---
# Optional Postgres: docker compose --profile postgres up
# DATABASE_URL=postgresql+psycopg://firescrapling:firescrapling@localhost:5432/firescrapling
# Then: cd apps/firescrapling/backend && alembic upgrade head

# --- Hosted SaaS surface (default: self-host / OSS) ---
# HOSTED_MODE=false
# When true: Stripe billing routes and plan-gated managed fetch are enabled.

# After the first account, further signups need this (default: first-run only).
# ALLOW_REGISTRATION=false

# --- Public homepage playground (no API key; burns self-host provider credits) ---
# Opt-in only. Default is off.
# PLAYGROUND_ENABLED=false
# PLAYGROUND_RATE_LIMIT_PER_MINUTE=8
# PLAYGROUND_MAP_MAX_LINKS=40
# PLAYGROUND_CRAWL_LIMIT=3
# PLAYGROUND_RESULT_PREVIEW_CHARS=12000

# --- Crawl concurrency ---
# CRAWL_GLOBAL_CONCURRENCY=4
# CRAWL_PER_HOST_CONCURRENCY=2

# --- Billing (only when HOSTED_MODE=true) ---
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_PRO=price_…
# STRIPE_PRICE_TEAM=price_…

# --- MCP server (optional compose profile) ---
# FIRESCRAPLING_API_KEY=fs_…
# FIRESCRAPLING_BASE_URL=http://backend:8000

# --- OpenRouter (structured JSON extraction when scrape includes `schema`) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional (defaults are applied in code if unset)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional — OpenRouter app attribution (https://openrouter.ai/docs)
# OPENROUTER_HTTP_REFERER=https://yoursite.com
# OPENROUTER_APP_TITLE=FireScrapling

# Copy this file to ".env" in the same directory (project root) before running:
#   docker compose up
#   or local backend: uvicorn from apps/firescrapling/backend
#
# Docker Compose reads ".env" automatically for variable substitution and passes
# these values into the backend container (see docker-compose.yml).

# --- Backend (FastAPI / CORS) ---
# Comma-separated origins allowed by the API (browser + nginx proxy)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# API auth: require Authorization: Bearer <api_key> or X-API-Key for /v1/scrape|crawl|map
# Set to false for local dev only (no tenant isolation).
# API_REQUIRE_AUTH=true

# Allow http://localhost / private IPs for scrapes (local dev only).
# API_ALLOW_PRIVATE_URLS=false

# Per-key sliding window (requests per minute, in-process).
# RATE_LIMIT_PER_MINUTE=60

# --- Public homepage playground (no API key; IP rate limit + strict public URLs) ---
# PLAYGROUND_ENABLED=true
# PLAYGROUND_RATE_LIMIT_PER_MINUTE=8
# PLAYGROUND_MAP_MAX_LINKS=40
# PLAYGROUND_CRAWL_LIMIT=3
# PLAYGROUND_RESULT_PREVIEW_CHARS=12000

# --- OpenRouter (structured JSON extraction when scrape includes `schema`) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional (defaults are applied in code if unset)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional — OpenRouter app attribution (https://openrouter.ai/docs)
# OPENROUTER_HTTP_REFERER=https://yoursite.com
# OPENROUTER_APP_TITLE=FireScrapling
